includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - vendor
    ignoreErrors:
        # larastan validates a view-string literal against a skeleton app that never
        # boots this package's provider, so a namespace registered at RUNTIME is
        # invisible to it and every `view()` / `View::make()` call reads as an error.
        # The views exist; the suite renders them. Broad on purpose -- the narrow
        # forms missed `static method`, `Contracts\View\Factory` and the helper,
        # each of which had to be discovered from a red run.
        - '#expects view-string, string given#'
        # Generic array value types in docblocks are not enforced across the
        # (largely inherited) console layer; not a correctness concern.
        -
            identifier: missingType.iterableValue
        # @method docblock hints over laravel/prompts mirror its own loosely
        # typed Collection/Progress generics; IDE hints, not a correctness concern.
        -
            identifier: missingType.generics
        # PromptService is a thin pass-through to laravel/prompts; its generic
        # template friction (spin/table/progress) is inherent to that API.
        -
            identifier: argument.type
            path: src/Prompter/Services/PromptService.php
        -
            identifier: argument.templateType
            path: src/Prompter/Services/PromptService.php
        -
            identifier: return.unusedType
            path: src/Prompter/Services/PromptService.php
        # Exhaustive enum match keeps a defensive default arm for forward-compat.
        -
            identifier: match.alwaysTrue
            path: src/Prompter/Enums/FieldType.php
        # Terminal capability detection legitimately reads process env vars
        # (NO_COLOR/TERM/FORCE_COLOR); these are not Laravel config keys.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: src/Tools/Support/Capabilities.php
        # Performance metrics index by a computed numeric key; harmless.
        -
            identifier: offsetAccess.invalidOffset
            path: src/Tools/Commands/Services/CommandPerformanceService.php
        # Command observer matches against names that may arrive as mixed.
        -
            identifier: argument.type
            path: src/Tools/Observers/ConsoleCommandObserver.php
        # Consumer-facing test trait — used by downstream test suites, not by src.
        -
            identifier: trait.unused
            path: src/Testing/InteractsWithConsole.php
        # `$commandAliases` belongs to the CONSUMING command, not to this base or
        # trait: PHP rejects a trait and a using class declaring the same property
        # with different defaults, so it cannot be declared here. PHPStan sees only
        # the subclasses inside src/ — none of which declare it — and concludes the
        # property_exists() guard is always false. It is not: a downstream command
        # may declare one, and reading the property without the guard is the
        # `Undefined property` at construction this method exists to prevent.
        -
            identifier: function.alreadyNarrowedType
            paths:
                - src/Tools/Commands/Command.php
                - src/Tools/Commands/Concerns/SupportsNamespacedNames.php
        -
            identifier: function.impossibleType
            paths:
                - src/Tools/Commands/Command.php
                - src/Tools/Commands/Concerns/SupportsNamespacedNames.php
        # laranail/emojis is suggested, never required (it requires console), so it
        # is absent when console is analysed alone. The bridge is the one file that
        # names its classes, behind a class_exists() gate; its API is exercised for
        # real by EmojisBridgeInstalledTest. Ceiling measured 2026-09-26: 23.
        -
            identifier: class.notFound
            path: src/Tools/Support/EmojisBridge.php
            count: 23
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
